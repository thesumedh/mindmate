# MindMate FastAPI Backend Environment Variables

# Google Gemini API Key (Get one for free at https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if you wish to use GPT models as fallback/alternative)
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Settings (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
